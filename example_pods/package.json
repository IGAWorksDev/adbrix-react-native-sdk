{
  "name": "@igaworks/adbrix-react-native-sdk-example-pods",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "cd ios && pod install && cd .. && react-native run-ios",
    "ios:setup": "cd ios && pod install",
    "ios:clean": "rm -rf ios/build ios/Pods ios/*.xcworkspace ios/Podfile.lock",
    "start": "react-native start",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --scheme AdbrixReactNativeSdkExample --mode Debug"
  },
  "dependencies": {
    "@igaworks/adbrix-react-native-sdk": "file:../sdk",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-tracking-transparency": "^0.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/react": "^19.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
