{
  "name": "@igaworks/adbrix-react-native-sdk-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "rm -rf ios/build && npx react-native spm add --yes && react-native run-ios",
    "ios:run": "react-native run-ios",
    "start": "react-native start",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --scheme AdbrixReactNativeSdkExample --mode Debug --extra-params \"-sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO\"",
    "ios:spm": "./scripts/use-spm.sh",
    "ios:spm:scaffold": "npx react-native spm scaffold",
    "ios:pods": "./scripts/use-pods.sh",
    "ios:clean": "./scripts/clean.sh"
  },
  "dependencies": {
    "@igaworks/adbrix-react-native-sdk": "file:../sdk",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-tracking-transparency": "^0.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/react": "^19.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
